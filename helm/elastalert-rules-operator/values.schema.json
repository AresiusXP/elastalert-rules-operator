{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {"type": "object"},
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "tag": {"type": "string"}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "namespace": {"type": "string"},
          "kind": {"enum": ["ConfigMap", "Secret"]}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedAlerters": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "allowedAdditionalFields": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "allowedIndexPatterns": {"type": "array", "items": {"type": "string"}},
        "allowedHttpHosts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "secretRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "resync": {"type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"}
      }
    },
    "elastalert": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "deploymentName": {"type": "string"},
        "deploymentNamespace": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "readerSubjects": {"type": "array"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "apiServerCIDRs": {"type": "array", "items": {"type": "string"}},
        "metricsFrom": {"type": "array"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"}
      }
    }
  }
}
